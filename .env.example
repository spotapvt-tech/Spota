# Copy to .env.local and fill in for your environment (dev/staging/prod each
# get their own Supabase project once you have more than one).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional — error monitoring (see src/lib/monitoring.js). Leave unset and
# Sentry stays fully inactive; no code changes needed either way.
VITE_SENTRY_DSN=

# Google Maps JavaScript API key (Maps + Places libraries). Used by every
# map in the app (src/lib/googleMaps.js). Restrict it to your domains in
# the Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
